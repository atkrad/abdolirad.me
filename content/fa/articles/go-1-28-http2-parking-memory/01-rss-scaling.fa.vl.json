{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "مصرف حافظهٔ RSS با افزایش اتصال‌های HTTP/2",
  "title": { "text": "مصرف حافظهٔ RSS با افزایش اتصال‌های HTTP/2", "anchor": "end" },
  "data": { "url": "data/chart-data.csv" },
  "transform": [
    {
      "aggregate": [{ "op": "median", "field": "rss_mib", "as": "rss_mib" }],
      "groupby": ["case", "connections"]
    }
  ],
  "encoding": {
    "x": {
      "field": "connections",
      "type": "quantitative",
      "title": "اتصال‌های HTTP/2",
      "scale": { "domain": [0, 5000], "nice": false, "zero": true },
      "axis": {
        "values": [0, 1000, 5000],
        "labelExpr": "datum.value >= 1000 ? format(datum.value, ',') : datum.value",
        "labelAngle": 0,
        "grid": false
      }
    },
    "y": {
      "field": "rss_mib",
      "type": "quantitative",
      "title": "RSS (MiB)",
      "scale": { "zero": true }
    },
    "color": {
      "field": "case",
      "type": "nominal",
      "title": null,
      "sort": ["go127", "go128off", "go128"],
      "scale": {
        "domain": ["go127", "go128off", "go128"],
        "palette": "series"
      },
      "legend": {
        "labelExpr": "datum.value == 'go127' ? 'Go 1.27.2' : datum.value == 'go128off' ? 'Go 1.28، Parking غیرفعال' : 'Go 1.28، Parking فعال'"
      }
    }
  },
  "layer": [
    { "mark": { "type": "line" } },
    { "mark": { "type": "point" } }
  ]
}
