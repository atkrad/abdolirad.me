{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "مقایسهٔ StackInuse و HeapAlloc در ۵۰۰۰ اتصال",
  "title": { "text": "مقایسهٔ StackInuse و HeapAlloc در ۵۰۰۰ اتصال", "anchor": "end" },
  "data": { "url": "data/chart-data.csv" },
  "transform": [
    {
      "filter": "datum.connections == 5000 && (datum.case == 'go128' || datum.case == 'go128off')"
    },
    {
      "fold": ["stack_inuse_mib", "heap_alloc_mib"],
      "as": ["metric", "mib"]
    }
  ],
  "facet": {
    "field": "metric",
    "type": "nominal",
    "title": null,
    "columns": 2,
    "spacing": 32,
    "sort": ["stack_inuse_mib", "heap_alloc_mib"],
    "header": {
      "title": null,
      "labelExpr": "datum.value == 'stack_inuse_mib' ? 'StackInuse' : 'HeapAlloc'"
    }
  },
  "spec": {
    "width": 250,
    "height": 260,
    "encoding": {
      "x": {
        "field": "run",
        "type": "ordinal",
        "title": "اجرا",
        "sort": "ascending",
        "axis": {
          "labelAngle": 0,
          "grid": false,
          "labelExpr": "datum.value == 1 ? '۱' : datum.value == 2 ? '۲' : '۳'"
        }
      },
      "xOffset": { "field": "case", "type": "nominal", "sort": ["go128off", "go128"] },
      "y": {
        "field": "mib",
        "type": "quantitative",
        "title": "حافظه (MiB)",
        "scale": { "domain": [0, 120], "nice": false, "zero": true }
      },
      "color": {
        "field": "case",
        "type": "nominal",
        "title": null,
        "sort": ["go128off", "go128"],
        "scale": {
          "domain": ["go128off", "go128"],
          "palette": "series"
        },
        "legend": {
          "labelExpr": "datum.value == 'go128off' ? 'Go 1.28، Parking غیرفعال' : 'Go 1.28، Parking فعال'"
        }
      }
    },
    "layer": [
      { "mark": { "type": "bar" } },
      {
        "mark": { "type": "text", "dy": -10 },
        "encoding": {
          "text": { "field": "mib", "format": ".1f" },
          "color": { "value": "#252B38" }
        }
      }
    ]
  },
  "resolve": { "scale": { "y": "shared" } }
}
