{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "RSS savings with Parking enabled",
  "title": { "text": "RSS savings with Parking enabled", "anchor": "start" },
  "data": { "url": "data/chart-data.csv" },
  "transform": [
    {
      "filter": "(datum.case == 'go128' || datum.case == 'go128off') && (datum.connections == 1000 || datum.connections == 5000)"
    },
    {
      "pivot": "case",
      "value": "rss_mib",
      "groupby": ["run", "connections"]
    },
    { "calculate": "datum.go128off - datum.go128", "as": "rss_saved_mib" }
  ],
  "encoding": {
    "x": {
      "field": "connections",
      "type": "ordinal",
      "title": "HTTP/2 connections",
      "sort": "ascending",
      "axis": { "labelExpr": "format(datum.value, ',')", "labelAngle": 0, "grid": false }
    },
    "xOffset": { "field": "run", "type": "ordinal", "sort": "ascending" },
    "y": {
      "field": "rss_saved_mib",
      "type": "quantitative",
      "title": "RSS savings (MiB)",
      "scale": { "domain": [0, 120], "nice": false, "zero": true }
    },
    "color": {
      "field": "run",
      "type": "nominal",
      "title": "Run",
      "sort": "ascending",
      "scale": { "domain": [1, 2, 3], "palette": "run" },
      "legend": { "labelExpr": "'Run ' + datum.value" }
    }
  },
  "layer": [
    { "mark": { "type": "bar" } },
    {
      "mark": { "type": "text", "dy": -10 },
      "encoding": {
        "text": { "field": "rss_saved_mib", "format": ".1f" },
        "color": { "value": "#252B38" }
      }
    }
  ]
}
