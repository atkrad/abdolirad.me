{
  "name": "abdolirad.me",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node charts/png.mjs && node src/persian-dates.js && hugo --gc --minify --cleanDestinationDir --panicOnWarning",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev -c wrangler.dev.toml",
    "test": "node --test src/index.test.js src/preview-links.test.js src/output.test.js src/config.test.js src/persian-dates.test.js src/persian-dates-html.test.js src/chart-figure.test.js charts/charts.test.js charts/png.test.js charts/article-data.test.js",
    "test:charts": "node --test charts/charts.integration.test.js charts/png.integration.test.js",
    "check": "wrangler deploy --dry-run"
  },
  "devDependencies": {
    "jalaali-js": "^2.0.1",
    "miniflare": "5.20261012.0-beta",
    "wrangler": "^4.151.0"
  },
  "dependencies": {
    "medium-zoom": "^1.1.0"
  }
}
